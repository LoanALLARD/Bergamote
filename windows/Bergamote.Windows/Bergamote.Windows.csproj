<Project Sdk="Microsoft.NET.Sdk">
  <!-- L'app Windows : icône dans la zone de notification, camembert sous le curseur pendant un
       glisser depuis l'Explorateur, conversions avec WIC/WPF, Windows.Data.Pdf, Windows.Media.Ocr,
       PDFsharp et PdfPig. Compilable sur Mac (EnableWindowsTargeting), exécutable sur Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- La prise en charge des écrans haute résolution passe par le manifeste, comme pour toute app
         WPF ; l'avertissement vise les apps Windows Forms. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AssemblyName>Bergamote</AssemblyName>
    <RootNamespace>Bergamote.Desktop</RootNamespace>
    <AssemblyTitle>Bergamote</AssemblyTitle>
    <Description>Convertisseur de fichiers en camembert</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF et Windows Forms ensemble : on garde les noms WPF sans préfixe. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bergamote.Core\Bergamote.Core.csproj" />
    <InternalsVisibleTo Include="Bergamote.Windows.Tests" />
  </ItemGroup>
</Project>
